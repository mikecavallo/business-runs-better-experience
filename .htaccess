# Business Runs Better - Apache config for shared hosting (Bluehost/cPanel)

Options -Indexes
DirectoryIndex index.html

# Force HTTPS and the bare domain
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://businessrunsbetter.com%{REQUEST_URI} [L,R=301]

# /services on its own has no page: the services live on the landing page
RewriteRule ^services/?$ /#explore [R=302,NE,L]

# The Work page became the Portfolio
RewriteRule ^work(\.html)?/?$ /portfolio.html [R=301,L]

# Short URLs (/pricing, /about) redirect to the real page, so each page has one address
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z-]+)/?$ /$1.html [R=301,L]

# Missing pages get the site's own 404 page, with the full site map
ErrorDocument 404 /404.html

# Never serve source/dev files, includes or config templates
<FilesMatch "\.(py|md|csv|log|sh|sqlite)$|^\.git|^brb-lib\.php$|^config\.sample\.php$">
  Require all denied
</FilesMatch>

# The lead tracker and webhook must never be cached or indexed
<FilesMatch "^(leads|stripe-webhook|contact|checkout)\.php$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store"
    Header always set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</FilesMatch>

# Correct types for the self-hosted assets
AddType image/webp .webp
AddType font/woff2 .woff2
AddType audio/mpeg .mp3

# Cache static assets for a month; always revalidate the page itself
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  # CSS and JS links carry a ?v= number, so a change always gets a fresh copy
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
